# new keep alive settings, private constructor
ProblemFilters.exclude[DirectMissingMethodProblem]("akka.projection.grpc.consumer.GrpcQuerySettings.this")
# internal protocol classes, keep alive in StreamOut/InitReq
ProblemFilters.exclude[Problem]("akka.projection.grpc.internal.proto.*")
# replication keep alive settings, private constructors
ProblemFilters.exclude[DirectMissingMethodProblem]("akka.projection.grpc.replication.scaladsl.ReplicationSettings.this")
ProblemFilters.exclude[DirectMissingMethodProblem]("akka.projection.grpc.replication.javadsl.ReplicationSettings.this")
